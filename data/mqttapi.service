[Unit]
Description=MQTT API
After=network-online.target mysql.service docker.service
Wants=network-online.target mysql.service docker.service
#After=network.target mysql.service docker.service
#Wants=mysql.service
[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Linux-Administration/mqtt
ExecStart=//home/ubuntu/Linux-Administration/venv/bin/python /home/ubuntu/Linux-Administration/mqtt/api.py
#ExecStartPre=/home/ubuntu/Linux-Administration/venv/bin/python -m pip install -r /home/ubuntu/Linux-Administration/mqtt/requirements.txt
#ExecStart=/home/ubuntu/Linux-Administration/venv/bin/python /home/ubuntu/Linux-Administration/mqtt/api.py
#Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10
TimeoutStartSec=300
[Install]
WantedBy=multi-user.target
